### Variables globales
@url = http://localhost:8080/api/videojuegos

### 1. POST - Crear un nuevo videojuego (201 Created)
POST {{url}}
Content-Type: application/json

{
  "titulo": "Elden Ring",
  "steamAppId": "1245620",
  "estado": "Jugando",
  "horasJugadas": 45.5,
  "porcentajeHistoria": 60.0,
  "precioObjetivo": 0.0,
  "ultimaPartida": "2024-05-10",
  "emailUsuario": "alumno@daw.com",
  "alertaOfertaActiva": false,
  "logrosDesbloqueados": ["First Blood", "Godrick Defeated"]
}

> {%
    // Este pequeño script atrapa el UUID generado y lo guarda para las siguientes peticiones
    client.global.set("uuid", response.body.codigoRegistro);
%}

### 2. POST - Error de Validación 400 (Horas negativas y título corto)
POST {{url}}
Content-Type: application/json

{
  "titulo": "A",
  "steamAppId": "abc",
  "estado": "Jugando",
  "horasJugadas": -10.0,
  "porcentajeHistoria": 150.0,
  "precioObjetivo": 0.0,
  "ultimaPartida": "2050-01-01",
  "emailUsuario": "correo-invalido",
  "alertaOfertaActiva": false
}

### 3. GET - Obtener todos los juegos (200 OK)
GET {{url}}

### 4. GET - Obtener un juego específico (200 OK)
GET {{url}}/{{uuid}}

### 5. GET - Error 404 (Recurso no encontrado)
GET {{url}}/uuid-inventado-1234

### 6. PATCH - Actualización parcial (200 OK)
PATCH {{url}}/{{uuid}}
Content-Type: application/json

{
  "horasJugadas": 80.0,
  "porcentajeHistoria": 100.0,
  "estado": "Completado"
}

### 7. DELETE - Borrar juego (204 No Content)
DELETE {{url}}/{{uuid}}